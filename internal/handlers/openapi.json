      "Unit": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64",
            "example": 1
          },
          "property_id": {
            "type": "integer",
            "format": "int64",
            "example": 1
          },
          "unit_number": {
            "type": "string",
            "example": "MAIN"
          },
          "floor_plan_name": {
            "type": "string",
            "nullable": true,
            "example": "3BR/1BA Classic"
          },
          "bedrooms": {
            "type": "number",
            "format": "double",
            "example": 3
          },
          "bathrooms": {
            "type": "number",
            "format": "double",
            "example": 1.5
          },
          "rentable_sq_ft": {
            "type": "integer",
            "example": 1150
          },
          "status": {
            "type": "string",
            "enum": [
              "OCCUPIED",
              "VACANT_READY",
              "VACANT_RENOVATION",
              "NON_REVENUE_MODEL"
