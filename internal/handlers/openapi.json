      "Tenant": {
        "type": "object",
        "properties": {
          "tenant_id": { "type": "integer", "format": "int64", "example": 1 },
          "tenant_initials": { "type": "string", "maxLength": 4, "example": "JD" },
          "property_id": { "type": "integer", "format": "int64", "example": 1 },
          "unit_number": { "type": "integer", "example": 1 },
          "monthly_rent": { "type": "number", "format": "double", "example": 1850.00 },
          "pet_count": { "type": "integer", "example": 0 },
          "move_in_date": { "type": "string", "format": "date-time", "nullable": true, "example": "2026-01-01T00:00:00Z" },
          "move_out_date": { "type": "string", "format": "date-time", "nullable": true, "example": null },
          "lease_start_date": { "type": "string", "format": "date-time", "nullable": true, "example": "2026-01-01T00:00:00Z" },
          "lease_end_date": { "type": "string", "format": "date-time", "nullable": true, "example": "2026-12-31T00:00:00Z" },
          "security_deposit": { "type": "number", "format": "double", "example": 1850.00 },
          "created_at": { "type": "string", "format": "date-time", "example": "2026-10-20T15:24:28Z" }
        }
      },
      "TenantRequest": {
        "type": "object",
        "required": [
          "tenant_initials",
          "monthly_rent"
        ],
        "properties": {
          "tenant_initials": { "type": "string", "minLength": 1, "maxLength": 4, "example": "JD" },
          "unit_number": { "type": "integer", "minimum": 1, "default": 1, "example": 1 },
          "monthly_rent": { "type": "number", "format": "double", "minimum": 0, "maximum": 9999999999.99, "example": 1850.00 },
          "pet_count": { "type": "integer", "minimum": 0, "maximum": 32767, "default": 0, "example": 0 },
          "move_in_date": { "type": "string", "format": "date-time", "nullable": true, "example": "2026-01-01T00:00:00Z" },
          "move_out_date": { "type": "string", "format": "date-time", "nullable": true, "example": null },
          "lease_start_date": { "type": "string", "format": "date-time", "nullable": true, "example": "2026-01-01T00:00:00Z" },
          "lease_end_date": { "type": "string", "format": "date-time", "nullable": true, "example": "2026-12-31T00:00:00Z" },
          "security_deposit": { "type": "number", "format": "double", "minimum": 0, "maximum": 9999999999.99, "default": 0, "example": 1850.00 }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string",
            "example": "invalid request body"
          }
