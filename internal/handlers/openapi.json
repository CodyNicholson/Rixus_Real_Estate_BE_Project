              "SINGLE_FAMILY",
              "CONDO_TOWNHOME",
              "MULTI_FAMILY_2_4",
              "MULTI_FAMILY_5_PLUS",
              "MIXED_USE"
            ],
            "description": "Property rows only"
          },
          "street_address": {
            "type": "string"
          },
          "city": {
            "type": "string"
          },
          "state": {
            "type": "string"
          },
          "property_count": {
            "type": "integer",
            "format": "int64",
            "example": 6
