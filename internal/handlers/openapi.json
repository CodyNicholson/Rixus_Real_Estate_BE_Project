          "is_renovated": {
            "type": "boolean"
          },
          "market_rent": {
            "type": "number",
            "format": "double",
            "example": 2450
          },
          "in_place_rent": {
            "type": "number",
            "format": "double",
            "example": 2300
          },
          "monthly_rubs_charge": {
            "type": "number",
            "format": "double",
            "example": 75
          },
          "monthly_pet_rent": {
            "type": "number",
            "format": "double",
            "example": 0
          },
          "monthly_parking_storage": {
            "type": "number",
            "format": "double",
            "example": 0
