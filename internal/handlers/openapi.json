          "credit_card_last4": {
            "type": "string",
            "nullable": true
          }
        }
      },
      "FinancialDashboard": {
        "type": "object",
        "properties": {
          "summary": {
            "$ref": "#/components/schemas/FinancialMetrics"
          },
          "properties": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FinancialMetrics"
            }
          },
          "legal_entities": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/LegalEntity"
            }
          }
