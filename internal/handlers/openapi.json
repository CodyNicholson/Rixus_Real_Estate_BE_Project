            "example": 14
          },
          "rentable_sq_ft": {
            "type": "integer",
            "format": "int64",
            "example": 19170
          },
          "purchase_price": {
            "type": "number",
            "format": "double"
          },
          "all_in_cost_basis": {
            "type": "number",
            "format": "double"
