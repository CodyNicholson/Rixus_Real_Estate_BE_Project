# Server Configuration
PORT=8080
CORS_ORIGIN=http://localhost:3000

# Database Connection (PostgreSQL)
DB_USER=postgres
DB_PASSWORD=your_secure_db_password_here
DB_NAME=rixus
DATABASE_URL=postgres://postgres:your_secure_db_password_here@db:5432/rixus?sslmode=disable

# Authentication Secrets (Must be at least 32 characters)
JWT_SECRET=your_rotated_64_char_hex_secret_here

# Cloudflare Access Zero Trust Configuration
# Found in Cloudflare Zero Trust Dashboard -> Settings -> Custom Pages -> Team Domain
CF_TEAM_DOMAIN=https://your-team.cloudflareaccess.com

# Found in Cloudflare Zero Trust Dashboard -> Access -> Applications -> Edit -> Overview -> AUD Tag
CF_POLICY_AUD=your_application_aud_tag_here

# Development Settings (MUST be false in production)
ALLOW_DEV_AUTH=false
DEV_CF_EMAIL=

