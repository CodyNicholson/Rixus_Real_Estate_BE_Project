            "type": "string",
            "example": "742 Evergreen Terrace"
          },
          "city": {
            "type": "string",
            "example": "Springfield"
          },
          "state": {
            "type": "string",
            "example": "OR"
          },
          "zip": {
            "type": "string",
            "example": "97477"
          },
          "units": {
            "type": "integer",
            "minimum": 1,
            "maximum": 32767,
            "example": 4
          }
        }
      },
      "CreatePropertyRequest": {
        "type": "object",
        "required": [
          "street_address"
        ],
        "properties": {
          "street_address": {
            "type": "string",
            "example": "742 Evergreen Terrace"
          },
          "city": {
            "type": "string",
            "example": "Springfield"
          },
          "state": {
            "type": "string",
            "example": "OR"
          },
          "zip": {
            "type": "string",
            "example": "97477"
          },
          "units": {
            "type": "integer",
            "minimum": 1,
            "maximum": 32767,
            "example": 4
          }
        }
